[Unit]
Description=Copy archived Crosery CPE PostgreSQL WAL to NAS
Documentation=file:///opt/crosery-cpe-console/deploy/data-plane/BACKUP-RESTORE.md
After=network-online.target
ConditionPathExists=/etc/crosery-cpe-console/data-plane.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/crosery-cpe-console/data-plane.env
ExecStart=/opt/crosery-cpe-console/deploy/data-plane/scripts/wal-sync.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Keep these paths aligned with data-plane.env or replace them in a systemd drop-in.
ReadWritePaths=/srv/crosery-cpe/backup-staging /mnt/crosery-cpe-backups
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native


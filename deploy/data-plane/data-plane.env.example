# Install as a root-owned 0600 environment file. Values below are placeholders.
# Keep all active PostgreSQL files and WAL on local SSD.
PATH=/opt/crosery-cpe-console/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
NODE_ENV=production
HOST=<tailscale-address-on-data-host>
PORT=8792
DATA_SERVICE_BIND_ADDRESS=<tailscale-address-on-data-host>
DATA_SERVICE_PORT=8792
# Docker Compose secret sources. The host-runtime systemd unit overrides the
# application-facing *_FILE variables with its private LoadCredential paths.
DATA_AUTH_BEARER_TOKEN_FILE=/etc/crosery-cpe-console/secrets/data-auth-bearer-token
AUTH_MAX_CLOCK_SKEW_SECONDS=300
MAX_BODY_BYTES=1048576
MAX_INGEST_BATCH=500
SNAPSHOT_REFRESH_MS=15000
MAINTENANCE_INTERVAL_MS=60000
MAINTENANCE_BATCH_SIZE=5000
# 公开查询最多 90 天，因此 raw/minute/hour 不能配置为低于 90 天。
RAW_RETENTION_DAYS=90
MINUTE_RETENTION_DAYS=90
HOUR_RETENTION_DAYS=400
# request_id identity tombstones must outlive every aggregate retention window.
IDENTITY_RETENTION_DAYS=410
INGEST_BATCH_RETENTION_DAYS=100
PG_POOL_MAX=12
PG_STATEMENT_TIMEOUT_MS=5000
MIGRATIONS_DIR=/opt/crosery-cpe-console/build/apps/data/migrations

# Compose configuration. POSTGRES_IMAGE must include a reviewed immutable digest.
NODE_IMAGE=node:24-bookworm-slim@sha256:<reviewed-image-digest>
DATA_IMAGE=crosery-cpe-data:<reviewed-release-id>
POSTGRES_IMAGE=postgres:18.6-bookworm@sha256:<reviewed-image-digest>
POSTGRES_DB=crosery_console
POSTGRES_OWNER_USER=console_owner
POSTGRES_APP_USER=console_app
POSTGRES_BACKUP_USER=console_backup
POSTGRES_OWNER_PASSWORD_FILE=/etc/crosery-cpe-console/secrets/postgres-owner-password
POSTGRES_APP_PASSWORD_FILE=/etc/crosery-cpe-console/secrets/postgres-app-password
POSTGRES_BACKUP_PASSWORD_FILE=/etc/crosery-cpe-console/secrets/postgres-backup-password
DATABASE_OWNER_URL_FILE=/etc/crosery-cpe-console/secrets/database-owner-url
DATABASE_APP_URL_FILE=/etc/crosery-cpe-console/secrets/database-app-url
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHM_SIZE=1gb
POSTGRES_ARCHIVE_TIMEOUT=300s
POSTGRES_LOG_MIN_DURATION_MS=250

# These two paths must resolve to a local SSD mount. The NAS path is backup-only.
PG_LOCAL_ROOT=/srv/crosery-cpe/postgresql
PG_BACKUP_STAGING_ROOT=/srv/crosery-cpe/backup-staging
NAS_BACKUP_ROOT=/mnt/crosery-cpe-backups
COMPOSE_FILE=/opt/crosery-cpe-console/deploy/data-plane/compose.yaml
COMPOSE_ENV_FILE=/etc/crosery-cpe-console/data-plane.env

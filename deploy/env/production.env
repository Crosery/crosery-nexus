# 正式环境的非密钥运行配置，随发布目录生效：scripts/release.mjs 写入 systemd drop-in
#   10-release-env.conf → EnvironmentFile=-/opt/crosery-api-console-current/deploy/env/production.env
# 仓库公开：这里只放通用的、可公开的项。域名、主机、内网地址、账号与一切密钥只在目标机
# /opt/crosery-api-console/.env；同名键以本文件为准（后加载）。改值即发版，不在服务器上手改。
CROSERY_ENV=production

HOST=127.0.0.1
PORT=8787
CPA_BASE_URL=http://127.0.0.1:8317
CPA_REQUEST_TIMEOUT_MS=10000
DATA_DIR=/opt/crosery-api-console/data
COOKIE_SECURE=true

USAGE_RETENTION_DAYS=90
SYNC_INTERVAL_MS=15000
USAGE_COLLECT_INTERVAL_MS=1000
REPORT_READ_WORKERS=2

# 数据面地址在目标机 .env（DATA_PLANE_BASE_URL），令牌走 data-plane.conf 的 LoadCredential
DATA_PLANE_ENABLED=true
DATA_PLANE_DASHBOARD_READ_MODE=sqlite

NGINX_UNLIMITED_SYNC_ENABLED=true
NGINX_UNLIMITED_POLICY_PATH=/opt/crosery-api-console/data/nginx-unlimited-policy.json
NGINX_UNLIMITED_STATUS_PATH=/opt/crosery-api-console/data/nginx-unlimited-status.json
NGINX_UNLIMITED_SYNC_TIMEOUT_MS=10000

CLAUDE_QUOTA_USAGE_TTL_MS=300000
CLAUDE_QUOTA_PROFILE_TTL_MS=3600000
CLAUDE_QUOTA_RATE_LIMIT_COOLDOWN_MS=600000
CLAUDE_QUOTA_MAX_RATE_LIMIT_COOLDOWN_MS=3600000

NATIVE_RESPONSES_ENABLED=false
CROSERY_SHARED_CATALOG=/opt/crosery-models-sync/catalog.json
RTK_BIN=/usr/local/bin/rtk
MAGPIE_UPSTREAM_RUNTIME=/opt/crosery-api-console/data/magpie-upstream
# 与 crosery-rtk-autoupdate.service 同一个状态目录：同步中心的「RTK 自动升级」读这里
RTK_STATE_DIR=/opt/crosery-api-console/data/rtk

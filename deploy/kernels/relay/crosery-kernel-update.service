# 预发布与正式同一份。角色来自 /etc/crosery/autoupdate.env（AUTOUPDATE_ROLE=preview|production，不入库）；没有这个文件
# 就按正式处理：只装带匹配预发布记录的二进制，且只在安静时段（scripts/kernel-applier.mjs）。
[Unit]
Description=Crosery gateway kernels: stage builder drops, CPA preview trial / production promotion, keep the Magpie standby current
After=network-online.target cli-proxy-api.service crosery-api-console.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/crosery-api-console-current
EnvironmentFile=-/etc/crosery/autoupdate.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/opt/crosery-node-current/bin/node /opt/crosery-api-console-current/scripts/kernel-applier.mjs auto
# cpa-install-binary.sh: baseline gates and real requests first (≤ 60 s), then 25 s after the swap, more when it restores
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

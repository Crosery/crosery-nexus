+/**
+ * task-78：把两个来源的价格归一化成同一形状（USD / 百万 token）。
+ * - OpenRouter：`pricing.prompt` / `completion` 是**每 token** 的美元字符串；缓存价在
+ *   `input_cache_read` / `input_cache_write`（部分模型没有）。
+ * - models.dev：`cost.input` / `output` / `cache_read` / `cache_write` 已经是**每百万 token**。
+ * 取不到就是 undefined（**不许用 0 冒充免费**）。
+ */
+function perMillion(value) {
+  const number = typeof value === "string" ? Number(value) : typeof value === "number" ? value : NaN;
+  if (!Number.isFinite(number) || number < 0) return undefined;
+  return number;
+}
+function openRouterPrice(row) {
+  const pricing = object(row.pricing);
+  const input = perMillion(pricing.prompt);
+  const output = perMillion(pricing.completion);
+  if (input === undefined && output === undefined) return undefined;
+  const cacheRead = perMillion(pricing.input_cache_read);
+  const cacheWrite = perMillion(pricing.input_cache_write);
+  return defined({
+    input: input === undefined ? undefined : input * 1e6,
+    output: output === undefined ? undefined : output * 1e6,
+    cacheRead: cacheRead === undefined ? undefined : cacheRead * 1e6,
+    cacheWrite: cacheWrite === undefined ? undefined : cacheWrite * 1e6,
+    unit: "usd-per-million-tokens",
+  });
+}
+function modelsDevPrice(row) {
+  const cost = object(row.cost);
+  const input = perMillion(cost.input);
+  const output = perMillion(cost.output);
+  if (input === undefined && output === undefined) return undefined;
+  return defined({
+    input,
+    output,
+    cacheRead: perMillion(cost.cache_read),
+    cacheWrite: perMillion(cost.cache_write),
+    unit: "usd-per-million-tokens",
+  });
+}
+/** 与各 host 的 `normalizeModelForPricing` 同语义：小写 + 去掉渠道前缀（第一个 `/` 之前）。 */
+function normalizePricingId(id) {
+  const lower = String(id).toLowerCase();
+  const slash = lower.indexOf("/");
+  return slash >= 0 ? lower.slice(slash + 1) : lower;
+}

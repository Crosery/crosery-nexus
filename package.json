{
  "name": "crosery-cpe-console",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "bin": {
    "cradmin": "cli/cradmin.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/data",
    "packages/contracts"
  ],
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:edge\"",
    "dev:all": "concurrently \"npm:dev:web\" \"npm:dev:edge\" \"npm:dev:data\"",
    "dev:web": "vite --configLoader runner",
    "dev:edge": "tsx watch server/index.ts",
    "dev:data": "tsx watch apps/data/src/index.ts",
    "dev:server": "npm run dev:edge",
    "build": "tsc -b && vite build --configLoader runner",
    "build:data": "npm run build --workspace @crosery/cpe-data",
    "build:all": "npm run build && npm run build:data",
    "start": "tsx server/index.ts",
    "start:data": "node build/apps/data/src/index.js",
    "migrate:data": "node build/apps/data/src/migrate-cli.js",
    "backfill:data": "node scripts/backfill-data-plane.mjs",
    "lint": "oxlint src server apps packages scripts cli",
    "typecheck": "tsc -b --pretty false && tsc -p apps/data/tsconfig.json --pretty false",
    "test": "node --test --test-timeout=30000 --import tsx server/*.test.ts apps/data/src/*.test.ts packages/contracts/*.test.ts scripts/*.test.mjs cli/*.test.mjs",
    "test:backfill": "node --test --test-timeout=30000 scripts/backfill-data-plane.test.mjs",
    "test:deploy": "sh deploy/data-plane/tests/postgres-secrets.test.sh && sh deploy/data-plane/tests/data-secrets.test.sh && sh deploy/data-plane/tests/wal-archive.test.sh",
    "test:pg": "npm run test:integration --workspace @crosery/cpe-data",
    "qa:bundle": "node scripts/check-bundle-budget.mjs",
    "benchmark:api": "node scripts/benchmark-api.mjs",
    "verify": "npm run test && npm run test:deploy && npm run lint && npm run build:all && npm run qa:bundle",
    "pricing:update": "node scripts/build-pricing.mjs"
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@talex-touch/tuffex": "^0.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "unocss": "^66.10.5",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/yauzl": "^3.4.0",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}

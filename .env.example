HOST=127.0.0.1
PORT=8787
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret
CPA_BASE_URL=http://127.0.0.1:8317
CPA_MANAGEMENT_KEY=replace-with-cpa-management-key
# CONSOLE_PASSWORD_FILE=/private/existing-console-password
# API Key 用户「接入」页展示的公网网关地址；不设时回退到本机网关地址。
# PUBLIC_GATEWAY_BASE_URL=https://ai.crosery.com/v1
# 渠道模型发现：单渠道探测间隔（下限 30 分钟）；共享目录合入目标渠道名，`off` 关闭合入。
# MODEL_DISCOVERY_INTERVAL_MS=1800000
# 定时发现会把新模型写进渠道表（即线上路由）；默认只在同步中心手动触发。
# MODEL_DISCOVERY_SCHEDULE=true
# MODEL_SYNC_CATALOG_TARGET=off
DATA_DIR=./data
USAGE_RETENTION_DAYS=90
SYNC_INTERVAL_MS=15000
# Claude 额度是上游控制面接口：成功结果缓存，429 后指数退避；禁止监控页高频撞上游。
CLAUDE_QUOTA_USAGE_TTL_MS=300000
CLAUDE_QUOTA_PROFILE_TTL_MS=3600000
CLAUDE_QUOTA_RATE_LIMIT_COOLDOWN_MS=600000
CLAUDE_QUOTA_MAX_RATE_LIMIT_COOLDOWN_MS=3600000
# 将控制台中启用且“总并发=0”的 Key 同步为 nginx 入口不限速。
# 生产需同时安装 deploy/systemd/ 下的 path/service 和 deploy/nginx/ 生成 include。
NGINX_UNLIMITED_SYNC_ENABLED=false
NGINX_UNLIMITED_POLICY_PATH=./data/nginx-unlimited-policy.json
NGINX_UNLIMITED_STATUS_PATH=./data/nginx-unlimited-status.json
NGINX_UNLIMITED_SYNC_TIMEOUT_MS=10000
COOKIE_SECURE=false
# 账号出口代理的候选项，格式 `标签=地址`，条目用换行、分号或逗号分隔。
# 「继承全局」与「强制直连」是内置选项，这里只列真实代理地址。
# 标签里有空格时整体加引号，否则 `. .env` 这类 shell 取值会被词拆分打断。
PROXY_PRESETS="专线代理=http://127.0.0.1:7890;海外出口=http://proxy.example.com:8080"
